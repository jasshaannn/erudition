<script>
(function(){
  var f=document.getElementById('f'),ok=document.getElementById('ok');
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var n=document.getElementById('n').value.trim(),p=document.getElementById('p').value.replace(/\D/g,'');
    if(!n||p.length<10){ok.textContent='Enter your name and a 10-digit phone number.';return}
    ok.textContent='Thanks, '+n+'. This is a design preview, so nothing was sent.';
  });
  document.querySelectorAll('.copy').forEach(function(b){
    b.addEventListener('click',function(){
      var el=document.getElementById(b.dataset.t),txt=el.textContent;
      function done(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy'},1400)}
      function sel(){var r=document.createRange();r.selectNodeContents(el);var s=getSelection();s.removeAllRanges();s.addRange(r);b.textContent='Selected';setTimeout(function(){b.textContent='Copy'},1400)}
      try{navigator.clipboard.writeText(txt).then(done,sel)}catch(x){sel()}
    });
  });
})();
</script>

