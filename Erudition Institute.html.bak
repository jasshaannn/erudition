<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Erudition Institute</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: contact bar, header, split hero with illustration and trust badge, navy enquiry band, 4-step journey, services grid, resource card, contact + map, navy footer. Orange is the single call-to-action color. */
:root{
  --bg:#F4F7F5; --surface:#FFFFFF; --ink:#14303F; --muted:#586C65;
  --navy:#173B52; --on-navy:#FFFFFF; --navy-muted:#B9CCD6;
  --teal:#1F6B87; --green:#5F8160; --leaf:#A9C58F; --line:#D9E3DD;
  --cta:#EA580C; --on-cta:#FFFFFF; --cta-navy:#FB923C;
  --soft:#E6EFEA; --plate:#FFFFFF; --field:#2A5169;
  --display:"Bricolage Grotesque","Arial Black",Arial,sans-serif;
  --body:"Public Sans","Segoe UI",Arial,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0E1D25; --surface:#152A34; --ink:#E7F0EB; --muted:#9DB2A9;
  --navy:#0A1820; --navy-muted:#9DB2BE;
  --teal:#7DBBD4; --green:#9DBB96; --line:#26424F;
  --cta:#F97316; --on-cta:#14303F;
  --soft:#1A323D; --plate:#F7F9F8; --field:#1B3340; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E1D25; --surface:#152A34; --ink:#E7F0EB; --muted:#9DB2A9;
  --navy:#0A1820; --navy-muted:#9DB2BE;
  --teal:#7DBBD4; --green:#9DBB96; --line:#26424F;
  --cta:#F97316; --on-cta:#14303F;
  --soft:#1A323D; --plate:#F7F9F8; --field:#1B3340; color-scheme:dark}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font:400 16px/1.6 var(--body);padding-block:0}
h1,h2,h3{font-family:var(--display);line-height:1.1;margin:0;text-wrap:balance;letter-spacing:-.01em}
p{margin:0}
a{color:var(--teal)}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px;border-radius:4px}
.in{max-width:1160px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.label{font:600 12px/1 var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--green)}
.ph{color:var(--teal)}
.navy .ph,.topbar .ph{color:var(--leaf)}

.topbar{background:var(--navy);color:var(--navy-muted);font-size:13px}
.topbar .in{display:flex;flex-wrap:wrap;gap:6px 26px;align-items:center;justify-content:space-between;padding-block:9px}
.topbar .grp{display:flex;flex-wrap:wrap;gap:6px 22px}
.topbar span{display:inline-flex;align-items:center;gap:7px;color:var(--navy-muted)}
.topbar svg{width:14px;height:14px;flex:none;stroke:var(--leaf);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:10px}
.plate{background:var(--plate);border-radius:10px;padding:4px 10px;display:flex}
.plate img{height:42px;width:auto;display:block}
nav{display:flex;gap:28px;font-weight:500;font-size:15px}
nav a{color:var(--ink);text-decoration:none}
nav a:hover{color:var(--cta)}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--cta);color:var(--on-cta);font:700 15px/1 var(--body);padding:14px 24px;border-radius:99px;border:0;text-decoration:none;cursor:pointer}
.btn:hover{filter:brightness(1.06)}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn.ghost:hover{border-color:var(--teal);filter:none}
.btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;padding-block:56px 72px}
.hero h1{font-size:clamp(40px,6vw,70px);font-weight:800;margin-top:14px}
.hero h1 em{display:block;margin-top:10px;font-style:normal;font-size:.56em;font-weight:700;color:var(--cta)}
.hero .lead{margin-top:20px;max-width:50ch;color:var(--muted);font-size:17px}
.callus{margin-top:28px;display:flex;align-items:center;gap:14px}
.callus .ic{width:48px;height:48px;border-radius:50%;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center;flex:none}
.callus .ic svg{width:22px;height:22px;stroke:var(--ink);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.callus small{display:block;font:600 12px/1.2 var(--body);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.callus strong{font:800 clamp(22px,3vw,28px)/1.2 var(--display)}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}

.art{position:relative;min-width:0}
.art svg.main{display:block;width:100%;height:auto;max-height:520px}
.s-bg{fill:var(--soft)} .s-ring{fill:none;stroke:var(--line);stroke-width:2;stroke-dasharray:3 8}
.s-navy{fill:var(--navy)} .s-teal{fill:var(--teal)} .s-leaf{fill:var(--leaf)} .s-green{fill:var(--green)} .s-cta{fill:var(--cta)}
.s-skin{fill:#E2B48F} .s-hair{fill:#2B2420} .s-page{fill:#F7F9F8} .s-line{stroke:var(--navy);fill:none}
.badge{position:absolute;left:2%;bottom:6%;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 18px 12px 12px;display:flex;gap:12px;align-items:center;box-shadow:0 10px 30px rgba(10,24,32,.14)}
.badge .dot{width:40px;height:40px;border-radius:50%;background:var(--navy);display:grid;place-items:center}
.badge .dot svg{width:20px;height:20px;stroke:var(--leaf);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.badge strong{display:block;font:800 20px/1 var(--display)}
.badge span{font-size:12px;color:var(--muted)}

.navy{background:var(--navy);color:var(--on-navy)}
.band{padding-block:64px;text-align:center}
.band h2{font-size:clamp(28px,4.4vw,44px);font-weight:700}
.band h2 em{font-style:normal;color:var(--cta-navy)}
.band .sub{max-width:62ch;margin:14px auto 0;color:var(--navy-muted)}
.formrow{margin:32px auto 0;max-width:1080px;background:var(--field);border-radius:18px;padding:22px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) auto;gap:16px;align-items:end;text-align:left}
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.field label{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--navy-muted)}
.field input,.field select{font:inherit;font-size:15px;color:#14303F;background:#F4F7F5;border:2px solid transparent;border-radius:8px;padding:11px 12px;width:100%;min-width:0}
.field input:focus,.field select:focus{border-color:var(--cta-navy);outline:none}
.ok{margin-top:14px;font-size:14px;color:var(--leaf);min-height:1.4em}

section.s{padding-block:64px}
.alt{background:var(--soft)}
.head{display:flex;flex-direction:column;gap:10px;max-width:640px;margin-bottom:34px}
.head h2{font-size:clamp(28px,4vw,40px);font-weight:700}
.head p{color:var(--muted)}
.head.c{margin-inline:auto;text-align:center;align-items:center}

.why{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center}
.why .pic{position:relative;border-radius:24px;background:var(--soft);aspect-ratio:1/1;max-width:460px;width:100%;overflow:hidden}
.why .pic svg{position:absolute;inset:0;width:100%;height:100%}
.points{display:flex;flex-direction:column;gap:18px;margin:26px 0 0;padding:0;list-style:none}
.points li{display:grid;grid-template-columns:36px 1fr;gap:14px;align-items:start}
.points .ck{width:36px;height:36px;border-radius:10px;background:var(--navy);color:var(--leaf);display:grid;place-items:center;font:800 16px/1 var(--display);font-variant-numeric:tabular-nums}
.points b{display:block;font-family:var(--display);font-size:18px}
.points span{color:var(--muted);font-size:15px}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:26px;min-width:0}
.prog{display:flex;flex-direction:column;gap:10px}
.prog .ico{width:52px;height:52px;border-radius:14px;background:var(--navy);display:grid;place-items:center}
.prog .ico svg{width:26px;height:26px;stroke:var(--leaf);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.prog h3{font-size:21px;margin-top:8px}
.prog p{color:var(--muted);font-size:15px}

.fb{display:flex;flex-direction:column;gap:12px}
.fb .q{border-left:3px solid var(--leaf);padding-left:14px;font-size:15px}
.fb .who{font-size:13px;font-weight:600}

.res{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center;border-radius:22px;padding:36px;background:var(--navy);color:var(--on-navy)}
.res h2{font-size:clamp(24px,3.2vw,34px)}
.res p{color:var(--navy-muted);margin-top:10px}
.res ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.res li{display:flex;align-items:center;gap:12px;background:var(--field);border-radius:10px;padding:13px 16px;font-weight:500}
.res li i{width:10px;height:10px;border-radius:50%;background:var(--cta-navy);flex:none}

.contact{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.rows{display:flex;flex-direction:column;gap:18px}
.row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding-bottom:16px;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0;padding-bottom:0}
.row .k{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.row .v{font-weight:500;overflow-wrap:anywhere}
.copy{flex:none;font:600 12px/1 var(--body);color:var(--ink);background:transparent;border:1.5px solid var(--line);border-radius:6px;padding:8px 10px;cursor:pointer}
.copy:hover{border-color:var(--teal)}
.map{position:relative;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:var(--soft);min-height:300px;display:flex;align-items:flex-end;min-width:0}
.map svg{position:absolute;inset:0;width:100%;height:100%}
.map .pin{position:relative;margin:16px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;width:calc(100% - 32px)}
.map .pin b{font-family:var(--display);font-size:17px;display:block}
.map .pin small{color:var(--muted);font-size:13px}

footer{background:var(--navy);color:var(--navy-muted);font-size:14px;border-top:4px solid var(--cta)}
footer .in{display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between;padding-block:30px}
footer .plate img{height:34px}
footer a{color:var(--leaf)}

@media (max-width:900px){
  .formrow{grid-template-columns:1fr 1fr}
  .formrow .btn{grid-column:1/-1;justify-content:center}
}
@media (max-width:820px){
  .hero{grid-template-columns:1fr;gap:28px;padding-block:36px 48px}
  .why,.contact,.res{grid-template-columns:1fr}
  .res{padding:26px}
  nav{display:none}
  .art svg.main{max-height:380px}
}
@media (max-width:520px){.formrow{grid-template-columns:1fr}.bar .btn{padding:12px 16px;font-size:14px}}
@media (prefers-reduced-motion:no-preference){.btn,.copy{transition:filter .15s,border-color .15s}}
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-phone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></symbol>
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M21 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></symbol>
  <symbol id="i-book" viewBox="0 0 24 24"><path d="M2 4h7a3 3 0 0 1 3 3v14a2 2 0 0 0-2-2H2zM22 4h-7a3 3 0 0 0-3 3v14a2 2 0 0 1 2-2h8z"/></symbol>
  <symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
  <symbol id="i-cap" viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5M22 9v6"/></symbol>
  <symbol id="i-doc" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></symbol>
  <symbol id="i-plane" viewBox="0 0 24 24"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
</svg>

<div class="topbar">
  <div class="in">
    <div class="grp">
      <span><svg><use href="#i-phone"/></svg>+91 9555770391</span>
      <span><svg><use href="#i-mail"/></svg>info@eruditioninstitute.com</span>
    </div>
    <span><svg><use href="#i-pin"/></svg>Bus Stand, Main, Khanna - Samrala Rd, Bardhalan, Punjab 141412</span>
  </div>
</div>

<header>
  <div class="in bar">
    <a class="plate" href="#top" aria-label="Erudition Institute home"><img alt="Erudition logo: an open book with a sprouting plant and graduation cap" src="data:image/png;base64,"></a>
    <nav aria-label="Main">
      <a href="#top">Home</a><a href="#journey">About</a><a href="#services">Services</a><a href="#contact">Contact</a>
    </nav>
    <a class="btn" href="#enquire">Get Started <svg><use href="#i-arrow"/></svg></a>
  </div>
</header>

<main id="top">
  <div class="in hero">
    <div>
      <p class="label">Erudition Institute</p>
      <h1>Unlock Your Future <em>with Global Education</em></h1>
      <p class="lead">Simplifying your journey to success. Whether you need student visa assistance, admission guidance or test preparation, our team is here to support you at every step to your dream university.</p>
      <div class="cta"><a class="btn" href="#enquire">Start Your Journey <svg><use href="#i-arrow"/></svg></a></div>
      <div class="callus">
        <span class="ic"><svg><use href="#i-phone"/></svg></span>
        <div><small>Contact us</small><strong>+91 9555770391</strong></div>
      </div>
    </div>

    <div class="art">
      <svg class="main" viewBox="0 0 520 480" role="img" aria-label="Illustration of a student with a book beside a growing plant">
        <circle class="s-bg" cx="270" cy="250" r="205"/>
        <circle class="s-ring" cx="270" cy="250" r="232"/>
        <path class="s-green" d="M100 360c-30-70-10-140 30-190 10 70 20 130-30 190z"/>
        <path class="s-leaf" d="M130 370c-6-60 16-120 60-160 0 60-10 120-60 160z"/>
        <path class="s-green" d="M440 360c30-70 10-140-30-190-10 70-20 130 30 190z"/>
        <path class="s-leaf" d="M410 370c6-60-16-120-60-160 0 60 10 120 60 160z"/>
        <path class="s-navy" d="M170 440c0-70 30-120 100-120s100 50 100 120z"/>
        <rect class="s-skin" x="252" y="290" width="36" height="40" rx="14"/>
        <circle class="s-skin" cx="270" cy="250" r="46"/>
        <path class="s-hair" d="M224 246c0-34 22-52 50-52 28 0 46 20 44 50-12-18-30-26-52-26-16 0-30 8-42 28z"/>
        <circle class="s-navy" cx="254" cy="254" r="4"/><circle class="s-navy" cx="288" cy="254" r="4"/>
        <path class="s-line" d="M258 272c8 8 20 8 28 0" stroke-width="3" stroke-linecap="round"/>
        <path class="s-teal" d="M170 196l100-44 100 44-100 44z"/>
        <path class="s-navy" d="M222 222v30c0 12 22 20 48 20s48-8 48-20v-30l-48 20z" opacity=".9"/>
        <path class="s-line" d="M370 196v44" stroke-width="3" stroke-linecap="round"/><circle class="s-cta" cx="370" cy="246" r="7"/>
        <path class="s-page" d="M190 400l80-26 80 26v50H190z"/>
        <path class="s-line" d="M270 374v76" stroke-width="3"/>
        <path d="M190 400l80-26 80 26" fill="none" stroke="var(--teal)" stroke-width="6" stroke-linejoin="round"/>
        <g transform="translate(402 118) rotate(10)"><rect class="s-teal" width="74" height="16" rx="3"/><rect class="s-leaf" y="-18" width="64" height="16" rx="3" x="6"/><rect class="s-navy" y="-36" width="70" height="16" rx="3" x="2"/></g>
        <g transform="translate(66 116)"><circle class="s-cta" r="26"/><use href="#i-plane" x="-13" y="-13" width="26" height="26" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></g>
      </svg>
      <div class="badge">
        <div class="dot"><svg><use href="#i-users"/></svg></div>
        <div><strong class="ph">[00,000+]</strong><span>Students guided</span></div>
      </div>
    </div>
  </div>

  <div class="navy" id="enquire">
    <div class="in band">
      <h2><em>Erudition Institute</em> – Bridging Dreams to Global Success!</h2>
      <p class="sub">Simplifying your journey to global education. Share your details and our team will call you back with a free consultation.</p>
      <form id="f" novalidate>
        <div class="formrow">
          <div class="field"><label for="n">Your name</label><input id="n" name="n" autocomplete="name" placeholder="Enter your name"></div>
          <div class="field"><label for="e">Email address</label><input id="e" name="e" type="email" autocomplete="email" placeholder="Enter your email"></div>
          <div class="field"><label for="p">Phone no.</label><input id="p" name="p" inputmode="tel" autocomplete="tel" placeholder="Enter your phone no."></div>
          <div class="field"><label for="c">Desired course</label>
            <select id="c"><option value="">Select course</option><option>IELTS / PTE</option><option>University Admissions</option><option>Visa Application</option><option>Career Counseling</option></select></div>
          <button class="btn" type="submit">Get a Free Consultation</button>
        </div>
        <p class="ok" id="ok" role="status"></p>
      </form>
    </div>
  </div>

  <section class="s" id="journey">
    <div class="in why">
      <div class="pic">
        <svg viewBox="0 0 400 400" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
          <rect class="s-bg" width="400" height="400"/>
          <circle class="s-leaf" cx="300" cy="110" r="70" opacity=".45"/>
          <path d="M60 320c60-90 140 10 200-70s60-120 80-150" fill="none" stroke="var(--teal)" stroke-width="4" stroke-dasharray="3 10" stroke-linecap="round"/>
          <circle class="s-navy" cx="60" cy="320" r="14"/><circle class="s-navy" cx="168" cy="276" r="10"/><circle class="s-navy" cx="262" cy="236" r="10"/>
          <circle class="s-cta" cx="340" cy="100" r="16"/>
          <g transform="translate(260 62) rotate(-12)"><use href="#i-plane" width="46" height="46" fill="none" stroke="var(--navy)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></g>
          <path class="s-green" d="M44 392c-14-34-4-70 16-96 6 36 10 66-16 96z"/>
        </svg>
      </div>
      <div>
        <p class="label">Your path</p>
        <h2 style="font-size:clamp(28px,4vw,40px);margin-top:12px">From first call to first day on campus</h2>
        <ul class="points">
          <li><span class="ck">1</span><div><b>Career counseling</b><span>A personalised session to map your career path and match it to global opportunities.</span></div></li>
          <li><span class="ck">2</span><div><b>Test preparation</b><span>IELTS and PTE coaching aimed at the band score your visa and university need.</span></div></li>
          <li><span class="ck">3</span><div><b>University admissions</b><span>Help choosing the right course and university for your academic profile, through to the application.</span></div></li>
